# {{ ansible_managed }}
network:
  version: 2
  ethernets:
    eth0:
{% if eth0_default_route | bool %}
      dhcp4: true
{% else %}
      # VirtualBox NAT: только для vagrant ssh, без шлюза — default идёт через inetRouter
      dhcp4: false
      addresses:
        - 10.0.2.15/24
      nameservers:
        addresses: [10.0.2.3]
{% endif %}
{% for iface in interfaces %}
{% set routes = (iface.routes | default([])) + ((iface.star_routes | default([])) if (star | bool) else []) %}
    {{ iface.name }}:
      addresses:
        - {{ iface.addr }}
{% if routes %}
      routes:
{% for r in routes %}
        - to: {{ r.to }}
          via: {{ r.via }}
{% endfor %}
{% endif %}
{% endfor %}
